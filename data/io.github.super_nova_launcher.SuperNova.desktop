[Desktop Entry]
Type=Application
Name=Super Nova
GenericName=Game Launcher
Comment=All your games in one library - GOG, Steam, Epic, Lutris - with Proton for Windows games
Exec=supernova %U
Icon=io.github.super_nova_launcher.SuperNova
Terminal=false
Categories=Game;
Keywords=games;supernova;nebula;launcher;gog;galaxy;steam;epic;proton;wine;
StartupWMClass=supernova
Actions=Minimized;

[Desktop Action Minimized]
Name=Start in the tray
Exec=supernova --minimized
